# Base de dados PostgreSQL. Na Neon, `neon deploy` / `neon env pull` escrevem estas duas variáveis:
#   DATABASE_URL           ligação pooled (-pooler) usada pela app
#   DATABASE_URL_UNPOOLED  ligação direta usada pelas migrações (prisma migrate)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uclfantasy"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/uclfantasy"

# Dados reais — API-Football (https://dashboard.api-football.com). Nunca expor no frontend.
FOOTBALL_PROVIDER=api-football
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
UCL_LEAGUE_ID=2
UCL_SEASON=2026

# Protege /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=troca-isto-por-um-segredo-longo
